# Shared environment values.
#
# Loaded first by config/settings/env.py, then overlaid with .env.{ENVIRONMENT}
# (for example .env.dev). docker-compose also reads this file directly.
#
# This file is gitignored — copy .env.example to get started.

ENVIRONMENT=dev

# Database. 127.0.0.1 works locally; docker-compose overrides this to `db`.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=orgplatform
POSTGRES_USER=orgplatform
POSTGRES_PASSWORD=

# Locally generated placeholder. Rotate before deploying anywhere real:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# No TLS terminator runs inside the compose network, so the redirect stays off.
# Set to 1 (or drop this line) when a real proxy terminates HTTPS in front.
DJANGO_SECURE_SSL_REDIRECT=0

# Demo dataset and superuser, applied by docker-entrypoint.sh on container start.
SEED_DATA=1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_EMAIL=admin@example.local
