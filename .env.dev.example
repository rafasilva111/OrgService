# Development overrides.
#
# Applied on top of .env when ENVIRONMENT=dev. Use it for machine-specific
# values so you do not have to keep editing the shared .env.
#
# This file is gitignored — copy .env.dev.example to get started.

# Developer-machine database, if it differs from the shared .env.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_DB=orgplatform
# POSTGRES_USER=orgplatform
# POSTGRES_PASSWORD=orgplatform

# Only needed when you want a specific key instead of the shared placeholder.
# DJANGO_SECRET_KEY=

# Local superuser for the demo dataset.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=admin123
# DJANGO_SUPERUSER_EMAIL=admin@example.local
